{
  "enabledPlugins": {
    "productivity@knowledge-work-plugins": true,
    "legal@knowledge-work-plugins": true,
    "frontend-design@anthropic-plugin-directory": true
  },
  "extraKnownMarketplaces": {
    "knowledge-work-plugins": {
      "source": {
        "source": "github",
        "repo": "anthropics/knowledge-work-plugins"
      }
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__claude-in-chrome__.*|mcp__Claude_Browser__.*|mcp__remote-devices__.*|mcp__computer-use__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/bloquear_sei.py\" || python \"$CLAUDE_PROJECT_DIR/.claude/hooks/bloquear_sei.py\"",
            "timeout": 10,
            "statusMessage": "Conferindo segurança no SEI"
          }
        ]
      }
    ]
  }
}
