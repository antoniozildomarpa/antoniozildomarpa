{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "WebSearch",
      "Bash(python scripts/*)",
      "Bash(python estrutura/criar_pastas.py *)",
      "PowerShell(python scripts/*)",
      "PowerShell(python estrutura/criar_pastas.py *)"
    ],
    "deny": [
      "mcp__claude_ai_Gmail__send_message",
      "mcp__claude_ai_Gmail__reply",
      "mcp__claude_ai_Gmail__forward",
      "mcp__claude_ai_Gmail__trash_message",
      "mcp__claude_ai_Gmail__trash_thread",
      "mcp__claude_ai_Gmail__delete_draft",
      "mcp__claude_ai_Google_Calendar__delete_event",
      "mcp__claude_ai_Google_Drive__trash_file",
      "mcp__claude_ai_Google_Drive__share_file",
      "Bash(rm *)",
      "Bash(del *)",
      "PowerShell(Remove-Item *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|Glob|Grep|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/bloqueio_sigiloso.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
